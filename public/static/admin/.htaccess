# PivArk Admin static — SSOT for Apache direct serve (survives dist rebuild).
# PHP fallback path: app/common/support/AdminStaticAsset.php

<IfModule mod_headers.c>
  # Entrypoint shell: never long-cache
  <FilesMatch "^(index\.html|_app\.config\.js)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # Vite hashed assets under dist/ (name-HASH.ext)
  <FilesMatch "\.[A-Za-z0-9_-]{6,}\.(js|css|mjs|woff2?|ttf|svg|png|jpe?g|gif|webp|ico)(\.(br|gz))?$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>